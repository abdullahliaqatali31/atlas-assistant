# Copy to .env. Prefer `pnpm keys set <NAME>` (OS credential store) for the keys;
# values here override the store. Never commit .env.
# Both providers are required for a normal setup.

# LLM provider (required)
ASSISTANT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ASSISTANT_LLM_MODEL=

# Voice provider (required): elevenlabs or azure
ASSISTANT_VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Azure AI Speech (ASSISTANT_VOICE_PROVIDER=azure). The free F0 tier includes
# real Pakistani Urdu voices: ur-PK-UzmaNeural (default) and ur-PK-AsadNeural.
# Store the key with `pnpm keys set AZURE_SPEECH_KEY`.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_VOICE=ur-PK-UzmaNeural

# Owner profile
ASSISTANT_OWNER_NAME=
ASSISTANT_TIMEZONE=Asia/Karachi
ASSISTANT_LANGUAGES=ur-Latn,en
# Optional quiet hours (owner-local, may wrap midnight): no unsolicited speech, urgent items notify silently.
# ASSISTANT_QUIET_HOURS=22:00-07:00

# Developer-only escape hatch: run text chat without a voice key.
# ASSISTANT_DEV_SKIP_VOICE=1
