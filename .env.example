# Copy to .env. Prefer `pnpm keys set <NAME>` (OS credential store) for the keys;
# values here override the store. Never commit .env.
# Both providers are required for a normal setup.

# LLM provider (required): anthropic, openai, gemini, openrouter, groq, deepseek,
# mistral, xai, ollama (local, no key) or custom (any OpenAI-compatible server).
# Each provider has its own key name: ANTHROPIC_API_KEY, OPENAI_API_KEY,
# GEMINI_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY,
# MISTRAL_API_KEY, XAI_API_KEY, LLM_API_KEY (custom). The desktop Setup screen
# sets all of this for you and can list the provider's models.
ASSISTANT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required for every provider except anthropic (default claude-opus-5-5).
ASSISTANT_LLM_MODEL=
# Optional cheaper model for background learning and its own questions
# (anthropic default: claude-haiku-5-5; others: the main model).
# ASSISTANT_LLM_BACKGROUND_MODEL=
# Server address for custom (and to override a provider's), e.g. http://localhost:8000/v1
# ASSISTANT_LLM_BASE_URL=

# Voice provider (required): elevenlabs or azure
ASSISTANT_VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Azure AI Speech (ASSISTANT_VOICE_PROVIDER=azure). The free F0 tier includes
# real Pakistani Urdu voices: ur-PK-UzmaNeural (default) and ur-PK-AsadNeural.
# Store the key with `pnpm keys set AZURE_SPEECH_KEY`.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_VOICE=ur-PK-UzmaNeural

# Owner profile
ASSISTANT_OWNER_NAME=
# Time zone: defaults to this PC's. Example: ASSISTANT_TIMEZONE=Asia/Karachi
# ASSISTANT_TIMEZONE=
ASSISTANT_LANGUAGES=ur-Latn,en
# Optional quiet hours (owner-local, may wrap midnight): no unsolicited speech, urgent items notify silently.
# ASSISTANT_QUIET_HOURS=22:00-07:00

# Developer-only escape hatch: run text chat without a voice key.
# ASSISTANT_DEV_SKIP_VOICE=1
