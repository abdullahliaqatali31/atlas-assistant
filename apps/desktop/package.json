{
  "name": "@assistant/desktop",
  "productName": "Personal Assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Electron shell: sandboxed renderer, preload bridge, tray and supervised runtime process.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "mammoth": "1.12.3",
    "maplibre-gl": "5.24.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@assistant/initiative": "workspace:*",
    "@assistant/mcp": "workspace:*",
    "@assistant/memory": "workspace:*",
    "@assistant/policy": "workspace:*",
    "@assistant/providers": "workspace:*",
    "@assistant/runtime": "workspace:*",
    "@assistant/shared": "workspace:*",
    "@huggingface/transformers": "4.3.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "9.8.1",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdf-lib": "1.17.1",
    "png-to-ico": "^3.0.2",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "org.personal-assistant.desktop",
    "productName": "Personal Assistant",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Personal Assistant",
      "license": "../../LICENSE"
    },
    "extraResources": [
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../docs/THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      }
    ]
  },
  "author": "Personal Assistant contributors",
  "optionalDependencies": {
    "@napi-rs/keyring-win32-x64-msvc": "2.1.1"
  }
}
