{
  "name": "@assistant/desktop",
  "productName": "Personal Assistant",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Atlas: a Node gateway (runtime, PC services, Playwright browser, tray) serving its web interface.",
  "main": "out/gateway/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build -c vite.gateway.config.ts",
    "start": "node --disable-warning=ExperimentalWarning out/gateway/index.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@cesium/core": "0.1.0",
    "@cesium/engine": "26.4.0",
    "@napi-rs/keyring": "^2.1.1",
    "cesium": "^1.146.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "hls.js": "1.6.13",
    "mammoth": "1.12.3",
    "maplibre-gl": "5.24.0",
    "playwright-core": "1.56.1",
    "satellite.js": "7.1.0",
    "sherpa-onnx-node": "1.13.8",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@assistant/initiative": "workspace:*",
    "@assistant/mcp": "workspace:*",
    "@assistant/memory": "workspace:*",
    "@assistant/policy": "workspace:*",
    "@assistant/providers": "workspace:*",
    "@assistant/runtime": "workspace:*",
    "@assistant/shared": "workspace:*",
    "@huggingface/transformers": "4.3.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "9.8.1",
    "lucide-react": "^1.59.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdf-lib": "1.17.1",
    "png-to-ico": "^3.0.2",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "8.3.4"
  },
  "author": "Personal Assistant contributors",
  "optionalDependencies": {
    "@napi-rs/keyring-win32-x64-msvc": "2.1.1"
  },
  "bin": {
    "atlas": "bin/atlas.mjs"
  }
}
